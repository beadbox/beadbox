{
  "name": "@beadbox/server",
  "version": "0.0.0",
  "description": "Bun sidecar for Beadbox. kkrpc-over-stdio entrypoint; handlers land in P1.[2-6].",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beadbox/beadbox.git"
  },
  "author": "Nelson Melo",
  "homepage": "https://github.com/beadbox/beadbox#readme",
  "bugs": {
    "url": "https://github.com/beadbox/beadbox/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./handlers": "./src/handlers/index.ts",
    "./subscribe-protocol": "./src/subscribe-protocol.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "tsc --noEmit",
    "test": "bun test --parallel=4",
    "typecheck": "tsc --noEmit",
    "quality:mutation": "stryker run stryker.config.json",
    "_note:macos-sign": "macOS rejects unsigned Mach-O with 'load code signature error 4' (Bun --compile gap). copy-sidecar.sh runs --remove-signature first (else --sign errors 'invalid or unsupported format'), then ad-hoc sign. The notarized .app overrides this with the real signing identity at bundle time.",
    "build:sidecar": "bash ../../src-tauri/scripts/copy-sidecar.sh",
    "build:macos-arm64": "bash ../../src-tauri/scripts/copy-sidecar.sh --target aarch64-apple-darwin",
    "build:macos-x64": "bash ../../src-tauri/scripts/copy-sidecar.sh --target x86_64-apple-darwin",
    "build:linux-x64": "bash ../../src-tauri/scripts/copy-sidecar.sh --target x86_64-unknown-linux-gnu",
    "build:windows-x64": "bash ../../src-tauri/scripts/copy-sidecar.sh --target x86_64-pc-windows-msvc"
  },
  "dependencies": {
    "kkrpc": "0.6.7",
    "mysql2": "^3.18.2"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@types/bun": "1.1.14",
    "@types/node": "^22",
    "typescript": "5.7.2"
  }
}
