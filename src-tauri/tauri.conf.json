{
  "$schema": "https://raw.githubusercontent.com/nicedoc/schemas/master/tauri/schema.json",
  "productName": "Beadbox",
  "identifier": "com.nmelo.beadbox",
  "version": "0.26.1",
  "build": {
    "beforeDevCommand": "bash src-tauri/scripts/copy-sidecar.sh && cd packages/client && bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bash src-tauri/scripts/copy-sidecar.sh && cd packages/client && bun run build",
    "frontendDist": "../packages/client/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/beadbox/beadbox/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExQzEwMkQxQTNBOTkwQjUKUldTMWtLbWowUUxCRWFMTXNjUDJ3bG9HWS9GNXRDMWFEdGtiTExDa3dKM2pucnpzdXRaNFhRR0QK",
      "dialog": false
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/beadbox-sidecar"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Nelson Melo Rodriguez (K7Z8YKVA8G)",
      "entitlements": "./Entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "13.0",
      "dmg": {
        "background": "dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
